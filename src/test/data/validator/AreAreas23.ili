INTERLIS 2.3;
CONTRACTED MODEL AreAreas23
  AT "mailto:ce@eisenhutinformatik.ch" VERSION "2016-11-09" =
  	IMPORTS INTERLIS_ext;
  	
	DOMAIN
		Lkoord = COORD 480000.000 .. 850000.000 [INTERLIS.m],
					   70000.000 .. 310000.000 [INTERLIS.m],
					ROTATION 2 -> 1;

	TOPIC Topic=

		STRUCTURE StructA =
			flaeche : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.001;
		END StructA;

		STRUCTURE StructB =
			attr2 : BAG OF StructA;
		END StructB;

		STRUCTURE StructC =
			attr3 : BAG OF StructB;
		END StructC;

		CLASS ClassD =
			attr4 : BAG OF StructC;
		END ClassD;
    	
		CLASS ClassD1 EXTENDS ClassD =
			MANDATORY CONSTRAINT INTERLIS_ext.areAreas2(THIS,UNDEFINED,"attr4->attr3->attr2->flaeche");
		END ClassD1;
    	
		CLASS ClassD2 EXTENDS ClassD =
			MANDATORY CONSTRAINT INTERLIS_ext.areAreas2(THIS,"attr4->attr3","attr2->flaeche");
		END ClassD2;

		CLASS ClassD3 EXTENDS ClassD =
			SET CONSTRAINT INTERLIS_ext.areAreas3(ALL,UNDEFINED,"attr4->attr3->attr2->flaeche");
		END ClassD3;
		
		CLASS ClassE =
		    art: (a, b, c);
			flaeche : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.001;
			SET CONSTRAINT WHERE art == #a: INTERLIS.areAreas(ALL,UNDEFINED,>>flaeche);
		END ClassE;

		CLASS ClassF =
		    art: (a, b, c);
			attr2 : BAG OF StructA;
			SET CONSTRAINT WHERE art == #a: INTERLIS.areAreas(ALL,>>attr2,>>StructA->flaeche);
		END ClassF;
		
	END Topic;
	
	!! overlap tolerance of areAreas() (ilivalidator#468): each surface checked by areAreas() takes the
	!! WITHOUT OVERLAPS tolerance from the class of its object or structure element; areAreas() uses the
	!! largest of these tolerances for all surfaces it checks
	TOPIC OverlapTolerance =

		CLASS Base =
			Geom : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.05;
			!!@ name = GeomAreAreas
			SET CONSTRAINT INTERLIS.areAreas(ALL, UNDEFINED, >> Geom);
			!!@ name = GeomAreAreas3
			SET CONSTRAINT INTERLIS_ext.areAreas3(ALL, UNDEFINED, "Geom");
		END Base;

		CLASS Strict EXTENDS Base =
			Geom (EXTENDED) : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.001;
		END Strict;

		STRUCTURE Part =
			Geom : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.05;
		END Part;

		STRUCTURE StrictPart EXTENDS Part =
			Geom (EXTENDED) : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.001;
		END StrictPart;

		CLASS Holder =
			Parts : BAG OF Part;
			!!@ name = PartsGeomAreAreas
			SET CONSTRAINT INTERLIS.areAreas(ALL, >> Parts, >> Part->Geom);
		END Holder;

		CLASS UnparsableTextPath =
			Geom : SURFACE WITH (STRAIGHTS,ARCS) VERTEX Lkoord WITHOUT OVERLAPS > 0.05;
			!!@ name = GeomAreAreas3
			SET CONSTRAINT INTERLIS_ext.areAreas3(ALL, UNDEFINED, "Geom->");
		END UnparsableTextPath;

	END OverlapTolerance;
	
END AreAreas23.